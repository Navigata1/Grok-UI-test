{
  "name": "channel-booster",
  "version": "0.1.0",
  "private": true,
  "description": "A pre-shoot check for YouTube packaging: score the idea against proven demand, gate the title and thumbnail, and read every upload's numbers against your own channel.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "channel-booster": "bin/channel-booster.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "examples/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "booster": "cd .. && tsx channel-booster/cli/booster.ts",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsx scripts/build.ts && node dashboard/build.mjs",
    "verify": "npm run check && npm test && npm run build",
    "smoke": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
